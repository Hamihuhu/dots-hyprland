#!/usr/bin/env bash
# grimoire: Dotfile sync tool.
#
# Usage:
#   ./grimoire invoke   [--glance] [--scry] [section ...]  # deploy repo -> live
#   ./grimoire scribe   [--glance] [--scry] [section ...]  # collect live -> repo
#   ./grimoire inscribe                                     # edit grimoire.conf
#
# Sections and mappings are defined in grimoire.conf.
# If no sections are given, all sections are synced.

set -euo pipefail

#####################################################################################
# FILES TO IGNORE
# Paths relative to their respective source directories.
# Uses rsync exclude syntax (e.g. "monitors.conf", "subdir/file.conf")
IGNORED_FILES=(
    # Add files here, e.g.:
    "monitors.lua",
    "fish_variables",
)

#####################################################################################

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

#####################################################################################
# Arg parsing

SUBCMD="${1:-}"
shift || true

case "$SUBCMD" in
invoke | scribe) ;;
inscribe)
    editor="${EDITOR:-${VISUAL:-xdg-open}}"
    exec "$editor" "$REPO_ROOT/grimoire.conf"
    ;;
"" | help | --help | -h)
    echo "Usage: ./grimoire <invoke|scribe|inscribe> [--glance] [--scry] [section ...]"
    echo ""
    echo "  invoke      Deploy repo -> live system"
    echo "  scribe      Collect live system -> repo"
    echo "  inscribe    Edit grimoire.conf"
    echo ""
    echo "Flags:"
    echo "  --glance    Preview what would change, no files touched"
    echo "  --scry      Open diffs in your configured git difftool (implies --glance)"
    echo ""
    echo "Sections are defined in grimoire.conf. Run './grimoire inscribe' to edit."
    echo ""
    echo "Examples:"
    echo "  ./grimoire invoke                       # deploy everything"
    echo "  ./grimoire invoke --glance              # preview deploy"
    echo "  ./grimoire invoke --scry                # preview with difftool"
    echo "  ./grimoire scribe --glance quickshell   # preview quickshell collect"
    echo "  ./grimoire scribe fish hyprland         # collect fish and hyprland"
    echo "  ./grimoire inscribe                     # edit grimoire.conf"
    exit 0
    ;;
*)
    echo "Error: unknown subcommand '$SUBCMD'. Use: invoke, scribe, inscribe" >&2
    echo "Run './grimoire help' for usage." >&2
    exit 1
    ;;
esac

# Parse flags and section names
GLANCE=false
SCRY=false
SECTIONS=()
for arg in "$@"; do
    case "$arg" in
    --glance) GLANCE=true ;;
    --scry)
        SCRY=true
        GLANCE=true
        ;;
    *) SECTIONS+=("$arg") ;;
    esac
done

# If no sections specified, run all
should_run() { [[ ${#SECTIONS[@]} -eq 0 ]] || [[ " ${SECTIONS[*]} " == *" $1 "* ]]; }

#####################################################################################
# rsync options

exclude_args=()
for f in "${IGNORED_FILES[@]}"; do
    exclude_args+=(--exclude "$f")
done

rsync_opts=(-a --delete --out-format='%i %n' "${exclude_args[@]}")

section_had_entries=false
section_had_changes=false
section_header_printed=false

emit_section_header() {
    if ! $section_header_printed; then
        echo "[$current_section]"
        section_header_printed=true
    fi
}

flush_section() {
    [[ -z "$current_section" ]] && return 0
    if ! $section_had_entries; then
        return 0
    fi

    if $GLANCE; then
        if ! $section_had_changes; then
            echo "[$current_section] (no changes)"
        fi
    elif $section_header_printed; then
        echo ""
    fi

    return 0
}

do_diff() {
    local a="$1"
    local b="$2"
    if $SCRY; then
        git difftool -y --no-index -- "$a" "$b" || true
    else
        git diff --no-index -- "$a" "$b" || true
    fi
}

run_rsync() {
    local label="$1"
    local src="$2"
    local dest="$3"
    local changed=""
    if $GLANCE; then
        if [[ -d "$dest" ]]; then
            changed=$(rsync -a --delete --dry-run --out-format='%n' "${exclude_args[@]}" "$src"/ "$dest"/ 2>/dev/null) || true
        else
            changed="__create__"
        fi
    fi

    if $GLANCE && [[ -z "$changed" ]]; then
        return 0
    fi

    section_had_changes=true
    emit_section_header

    if $GLANCE; then
        echo "  [sync] $label"
        if [[ "$changed" == "__create__" ]]; then
            echo "    [new] destination would be created"
        else
            do_diff "$dest" "$src"
        fi
    else
        echo "  [sync] $src -> $dest"
        rsync "${rsync_opts[@]}" "$src"/ "$dest"/
    fi
}

ensure_parent_dir() {
    local path="$1"
    local parent
    parent="$(dirname "$path")"
    [[ "$parent" == "." ]] && return 0
    mkdir -p "$parent"
}

run_rsync_exclude() {
    local label="$1"
    local src="$2"
    local dest="$3"
    shift 3
    local extra_excludes=()
    for p in "$@"; do
        extra_excludes+=(--exclude "$p")
    done
    local changed=""
    if $GLANCE; then
        changed=$(rsync -a --delete --dry-run --out-format='%n' "${exclude_args[@]}" "${extra_excludes[@]}" "$src"/ "$dest"/ 2>/dev/null) || true
        if [[ -z "$changed" ]]; then
            return 0
        fi

        section_had_changes=true
        emit_section_header
        echo "  [sync] $label"
        while IFS= read -r f; do
            [[ -z "$f" ]] && continue
            [[ "$f" == "./" ]] && continue
            if [[ -f "$src/$f" ]] && [[ -f "$dest/$f" ]]; then
                do_diff "$dest/$f" "$src/$f"
            elif [[ -f "$src/$f" ]]; then
                echo "    [new] $f"
            else
                echo "    [del] $f"
            fi
        done <<<"$changed"
    else
        echo "  [sync] $src -> $dest (excluding: $*)"
        rsync "${rsync_opts[@]}" "${extra_excludes[@]}" "$src"/ "$dest"/
    fi
}

cp_file() {
    local label="$1"
    local src="$2"
    local dest="$3"

    if $GLANCE; then
        if [[ -f "$dest" ]]; then
            if cmp -s "$src" "$dest"; then
                return 0
            fi

            section_had_changes=true
            emit_section_header
            echo "  [copy] $label"
            do_diff "$dest" "$src"
        else
            section_had_changes=true
            emit_section_header
            echo "  [copy] $label"
            echo "    [new] destination would be created"
        fi
    else
        ensure_parent_dir "$dest"
        echo "  [copy] $src -> $dest"
        cp -f "$src" "$dest"
    fi
}

#####################################################################################
# Header

if $GLANCE; then
    echo "=== ${SUBCMD^^} --glance — no changes will be made. Run './grimoire $SUBCMD' to sync. ==="
elif [[ "$SUBCMD" == "invoke" ]]; then
    echo "=== INVOKE — deploying repo -> live ==="
else
    echo "=== SCRIBE — collecting live -> repo ==="
fi
echo ""

cd "$REPO_ROOT"

warnings=()

#####################################################################################
# Read mappings from grimoire.conf

current_section=""

while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip comments and blank lines
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line//[[:space:]]/}" ]] && continue

    # Section header
    if [[ "$line" =~ ^[[:space:]]*\[([^\]]+)\][[:space:]]*$ ]]; then
        flush_section
        current_section="${BASH_REMATCH[1]}"
        section_had_entries=false
        section_had_changes=false
        section_header_printed=false
        continue
    fi

    # Skip if section not requested
    should_run "$current_section" || continue

    # Parse: left -> right [!exclude ...]
    if [[ "$line" =~ ^[[:space:]]*(.+)[[:space:]]+-\>[[:space:]]+(.+)$ ]]; then
        repo_side="${BASH_REMATCH[1]}"
        right_side="${BASH_REMATCH[2]}"

        # Trim trailing whitespace from repo_side
        repo_side="${repo_side%"${repo_side##*[![:space:]]}"}"

        # Split right_side into live_path and excludes (!token)
        live_side=""
        excludes=()
        for token in $right_side; do
            if [[ "$token" == !* ]]; then
                excludes+=("${token#!}")
            else
                live_side="$token"
            fi
        done

        # Expand repo_side: relative paths are relative to REPO_ROOT
        if [[ "$repo_side" == /* ]] || [[ "$repo_side" == ~* ]] || [[ "$repo_side" == \$* ]]; then
            repo_side="${repo_side/#\~/$HOME}"
            repo_side=$(eval echo "$repo_side")
        else
            repo_side="$REPO_ROOT/$repo_side"
        fi

        # Expand live_side
        live_side="${live_side/#\~/$HOME}"
        live_side=$(eval echo "$live_side")

        # Set src/dest based on direction
        if [[ "$SUBCMD" == "invoke" ]]; then
            src="$repo_side"
            dest="$live_side"
        else
            src="$live_side"
            dest="$repo_side"
        fi
        label="${repo_side#$REPO_ROOT/}"
        [[ "$label" == "$repo_side" ]] && label="$repo_side"
        section_had_entries=true

        # Sync based on type. Existing repo paths define the type first.
        if [[ -d "$repo_side" ]]; then
            if [[ ${#excludes[@]} -gt 0 ]]; then
                run_rsync_exclude "$label" "$src" "$dest" "${excludes[@]}"
            else
                run_rsync "$label" "$src" "$dest"
            fi
        elif [[ -f "$repo_side" ]]; then
            cp_file "$label" "$src" "$dest"
        # For scribe, seed missing repo paths from the live side instead of skipping.
        elif [[ "$SUBCMD" == "scribe" && -d "$live_side" ]]; then
            if [[ ${#excludes[@]} -gt 0 ]]; then
                run_rsync_exclude "$label" "$src" "$dest" "${excludes[@]}"
            else
                run_rsync "$label" "$src" "$dest"
            fi
        elif [[ "$SUBCMD" == "scribe" && -f "$live_side" ]]; then
            cp_file "$label" "$src" "$dest"
        else
            warnings+=("skipped (not found in repo): $repo_side")
        fi
    else
        warnings+=("skipped (bad format): $line")
    fi
done <"$REPO_ROOT/grimoire.conf"

flush_section

#####################################################################################
# Footer

if $GLANCE; then
    echo "=== End of glance. Run './grimoire $SUBCMD' to sync. ==="
else
    echo "=== Done. Review changes with: git diff --stat ==="
fi

if [[ ${#warnings[@]} -gt 0 ]]; then
    echo ""
    echo "=== Warnings ==="
    for w in "${warnings[@]}"; do
        echo "  $w"
    done
fi
