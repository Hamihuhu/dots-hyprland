#!/usr/bin/env bash
# sync-back: Syncs local ~/.config changes back into dots/ in this repo.
# This is the reverse of ./setup install.
#
# Usage:
#   ./sync-back          # dry-run, shows what would change
#   ./sync-back --apply  # actually perform the sync

set -euo pipefail

#####################################################################################
# FILES TO IGNORE
# Paths relative to their respective source directories.
# Uses rsync exclude syntax (e.g. "monitors.conf", "subdir/file.conf")
IGNORED_FILES=(
  # Add files here, e.g.:
  # "monitors.conf"
)

#####################################################################################

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

APPLY=false
if [[ "${1:-}" == "--apply" ]]; then
  APPLY=true
fi

#####################################################################################

# Build rsync exclude args from IGNORED_FILES
exclude_args=()
for f in "${IGNORED_FILES[@]}"; do
  exclude_args+=(--exclude "$f")
done

rsync_opts=(-a --delete --out-format='%i %n' "${exclude_args[@]}")
if ! $APPLY; then
  rsync_opts+=(--dry-run)
fi

run_rsync() {
  local src="$1"
  local dest="$2"
  echo "  [sync] $src -> $dest"
  rsync "${rsync_opts[@]}" "$src"/ "$dest"/
}

run_rsync_exclude() {
  # run_rsync_exclude <src> <dest> <extra_exclude_pattern> [...]
  local src="$1"
  local dest="$2"
  shift 2
  local extra_excludes=()
  for p in "$@"; do
    extra_excludes+=(--exclude "$p")
  done
  echo "  [sync] $src -> $dest (extra excludes: $*)"
  rsync "${rsync_opts[@]}" "${extra_excludes[@]}" "$src"/ "$dest"/
}

cp_file() {
  local src="$1"
  local dest="$2"
  echo "  [copy] $src -> $dest"
  if $APPLY; then
    cp -f "$src" "$dest"
  else
    # Show diff summary for dry-run
    if [[ -f "$dest" ]]; then
      diff --brief "$src" "$dest" || true
    else
      echo "         (destination does not exist yet)"
    fi
  fi
}

#####################################################################################

if ! $APPLY; then
  echo "=== DRY RUN — no changes will be made. Run with --apply to sync. ==="
  echo ""
fi

cd "$REPO_ROOT"

# --- Misc .config dirs and files (everything tracked in dots/.config except special-cased ones) ---
echo "[misc .config]"
for i in $(find dots/.config/ -mindepth 1 -maxdepth 1 \
    ! -name 'quickshell' \
    ! -name 'fish' \
    ! -name 'hypr' \
    ! -name 'fontconfig' \
    -exec basename {} \;); do
  src="$XDG_CONFIG_HOME/$i"
  dest="$REPO_ROOT/dots/.config/$i"
  if [[ -d "$dest" ]]; then
    run_rsync "$src" "$dest"
  elif [[ -f "$dest" ]]; then
    cp_file "$src" "$dest"
  fi
done

# --- konsole ---
echo ""
echo "[konsole]"
run_rsync "$XDG_DATA_HOME/konsole" "$REPO_ROOT/dots/.local/share/konsole"

# --- quickshell ---
echo ""
echo "[quickshell]"
run_rsync "$XDG_CONFIG_HOME/quickshell" "$REPO_ROOT/dots/.config/quickshell"

# --- fish (exclude conf.d — handled separately below) ---
echo ""
echo "[fish]"
run_rsync_exclude "$XDG_CONFIG_HOME/fish" "$REPO_ROOT/dots/.config/fish" "conf.d"

echo ""
echo "[fish/conf.d]"
run_rsync "$XDG_CONFIG_HOME/fish/conf.d" "$REPO_ROOT/dots/.config/fish/conf.d"

# --- fontconfig ---
echo ""
echo "[fontconfig]"
run_rsync "$XDG_CONFIG_HOME/fontconfig" "$REPO_ROOT/dots/.config/fontconfig"

# --- hyprland ---
echo ""
echo "[hypr/hyprland]"
run_rsync "$XDG_CONFIG_HOME/hypr/hyprland" "$REPO_ROOT/dots/.config/hypr/hyprland"

echo ""
echo "[hypr/custom]"
run_rsync "$XDG_CONFIG_HOME/hypr/custom" "$REPO_ROOT/dots/.config/hypr/custom"

echo ""
echo "[hypr single files]"
for i in hyprlock.conf hyprland.lua hypridle.conf; do
  cp_file "$XDG_CONFIG_HOME/hypr/$i" "$REPO_ROOT/dots/.config/hypr/$i"
done

# --- icons ---
echo ""
echo "[icons]"
cp_file "$XDG_DATA_HOME/icons/illogical-impulse.svg" "$REPO_ROOT/dots/.local/share/icons/illogical-impulse.svg"

#####################################################################################
echo ""
if $APPLY; then
  echo "=== Done. Review changes with: git diff --stat ==="
else
  echo "=== End of dry run. Run with --apply to sync. ==="
fi
